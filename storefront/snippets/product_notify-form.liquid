{%- comment -%}
  Back-in-stock ("notify me") form. Shared by `main-product`, `featured-product`
  and the selectable bundle.

  The inner markup only renders when `isBackInStock` is truthy — the surrounding
  `{% form %}` is always emitted because `<notify-form>` expects to find one.

  Accepts:
  - product: {Object} Product (required)
  - uid: {String} Suffix that makes DOM ids unique when several product sections
    share a page. Empty on the PDP, '-{section.id}' elsewhere.
{%- endcomment -%}

{%- liquid
  assign uid = uid | default: ''
  assign notify_form_id = 'back-in-stock-form' | append: uid
-%}

<notify-form>
  {%- form 'product',
    product,
    id: notify_form_id,
    novalidate: 'novalidate',
    class: 'main-product__notify-form',
    data-type: 'notify-form',
    method: 'post',
    action: '/',
    data-back-in-stock: 'true'
  -%}
    {% if isBackInStock %}
      <div
        class="main-product__back-in-stock{% if product.selected_or_first_available_variant.available %} hide{% endif %}"
        data-notify-form
      >
        <div class="main-product__back-in-stock-copy">
          <span class="main-product__back-in-stock-copy-text p-3">
            {{- 'products.product.back_in_stock_text' | t -}}
          </span>
          <span class="main-product__back-in-stock-copy-success p-3">
            {{- 'products.product.back_in_stock_thanks' | t -}}
          </span>
          <span class="main-product__back-in-stock-copy-error color-red p-3">
            {{- 'products.product.back_in_stock_error' | t -}}
          </span>
        </div>
        <div class="main-product__back-in-stock-form">
          <input
            type="email"
            placeholder="Email Address"
            id="pdp_bis_email{{ uid }}"
            data-notify-email
            class="main-product__back-in-stock-form-email main"
          >
          <button
            type="submit"
            class="btn btn--primary main-product__back-in-stock-form-button"
            data-notify-submit-btn
            data-submit-button
          >
            {{ 'products.product.back_in_stock_button' | t }}
          </button>
        </div>
      </div>
    {% endif %}
  {% endform %}
</notify-form>
