{%- comment -%}
  Accepts:
  - product: {Object} Product (required)
  - _metafields: {Object} product.metafields.details
  - block: {Object} Section block
  - _b: {Object} block.settings
  - uid: {String} Suffix that makes DOM ids unique across sections
{%- endcomment -%}

<selectable-bundle {{ block.shopify_attributes }}
  data-variants="{{ product.variants | json | escape }}">
  <div class="product-form">
    {%- render 'selectable-bundle-options',
    	product: product,
    	_metafields: _metafields,
    	uid: uid -%}

    {%- render 'buy-buttons',
      product: product,
      show_dynamic_checkout: _b.show_dynamic_checkout,
      uid: uid -%}
  </div>
</selectable-bundle>

<script src="{{ 'selectable-bundle.min.js' | asset_url }}" defer="defer"></script>

{% render 'product_notify-form', product: product, uid: uid %}
