{%- comment -%}
  Product features grid, sourced from the `details.product_features` product metafield.
  Shared by `main-product` and `featured-product`.

  Accepts:
  - product: {Object} Product (required)
  - block: {Object} Section block (optional, for shopify_attributes)
{%- endcomment -%}

{%- assign features = product.metafields.details.product_features.value -%}

<div {{ block.shopify_attributes }} class="grid grid--features">
  {% for feature in features %}
    <div>
      {{ feature.icon | image_url: width: feature.icon.width | image_tag: class: '' }}
      <span class="main-product__features-copy p-4">{{ feature.copy }}</span>
    </div>
  {% endfor %}
</div>
