{%- comment -%}
  Featured Product

  A portable version of `main-product`: the product comes from a section setting
  instead of the template, and every block is rendered through the shared
  `product_*` snippets so the two sections stay in step.

  Several of these can live on one page. Anything that would otherwise collide —
  radio group names, `<label for>` targets, modal ids, accordion ids — is
  suffixed with the section id, and the add-to-cart behaviour is handled by
  `<featured-product-form>` (featured-product.js), which scopes itself to
  `[data-product-scope]` rather than the document.
{%- endcomment -%}

{{ 'main-product.min.css' | asset_url | stylesheet_tag }}
{{ 'featured-product.css' | asset_url | stylesheet_tag }}

<script src="{{ 'featured-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product = section.settings.product
  assign uid = '-' | append: section.id
  assign show_media = section.settings.show_media
  if product.media.size == 0
    assign show_media = false
  endif
-%}

{%- if product == blank -%}
  {%- if request.design_mode -%}
    <div class="featured-product featured-product__placeholder">
      <p class="p-3">Select a product in the section settings.</p>
    </div>
  {%- endif -%}
{%- else -%}
  <section
    id="featured-product{{ uid }}"
    class="featured-product{% unless section.settings.show_background %} featured-product--no-background{% endunless %}"
    data-product-scope
    data-section-type="featured-product"
    data-section-id="{{ section.id }}"
  >
    <div
      class="featured-product__wrap{% if show_media %} featured-product__wrap--media-{{ section.settings.media_position }}{% else %} featured-product__wrap--no-media{% endif %}"
      data-product-id="{{ product.id }}"
    >
      {%- if show_media -%}
        {% render 'media-gallery', product: product %}
      {%- endif -%}

      <div class="featured-product__info container">
        <div class="featured-product__info-wrapper">
          <div class="main-product__info-blocks">
            <div class="product-modal__overlay" data-product-modal-overlay></div>

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}

                {%- when 'title' -%}
                  {% render 'product_title', product: product, block: block, heading_tag: 'h2' %}

                {%- when 'price' -%}
                  {% render 'product_price', product: product, block: block %}

                {%- when 'promo-text' -%}
                  {% render 'product_promo-text', product: product, block: block %}

                {%- when 'subtitle' -%}
                  {% render 'product_subtitle', block: block %}

                {%- when 'short_desc' -%}
                  {% render 'product_short-desc', product: product, block: block, uid: uid %}

                {%- when 'promo_carousel' -%}
                  {% render 'product_promo-carousel', product: product, block: block %}

                {%- when 'product_features' -%}
                  {% render 'product_features', product: product, block: block %}

                {%- when 'bundled_products' -%}
                  {% render 'product_bundled-products', product: product, block: block %}

                {%- when 'variant_picker' -%}
                  {% render 'product_variant-picker',
                    product: product,
                    block: block,
                    section_id: section.id,
                    uid: uid,
                    featured: true
                  %}

                {%- when 'selectable_bundle' -%}
                  {% render 'product_selectable-bundle', product: product, block: block, uid: uid %}

                {%- when 'shipping_details' -%}
                  {% render 'product_shipping-details', block: block %}

                {%- when 'rewards' -%}
                  {% render 'product_rewards', block: block %}

                {%- when 'accordions' -%}
                  {% render 'product_accordions', product: product, block: block, uid: uid %}

                {%- when 'details' -%}
                  {% render 'product_details', product: product, block: block, uid: uid %}

                {%- when 'warranty' -%}
                  {% render 'product_warranty', product: product, block: block, uid: uid %}

                {%- when 'pdf' -%}
                  {% render 'product_pdf', product: product, block: block, uid: uid %}

                {%- when 'faqs' -%}
                  {% render 'product_faqs', product: product, block: block, uid: uid %}

                {%- when 'report' -%}
                  {% render 'product_report', product: product, block: block, uid: uid %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured Product",
  "settings": [
    {
      "type": "header",
      "content": "Featured Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show media gallery",
      "default": true
    },
    {
      "type": "select",
